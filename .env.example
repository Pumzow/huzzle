# Copy this file to .env.local.

# Create a free API key at https://www.pexels.com/api/
PEXELS_API_KEY=

# Public level deployment destination.
HUZZLE_SCP_TARGET=

# Public manifest URL used by the browser. Its sibling images/ folder is derived automatically.
VITE_HUZZLE_LEVELS_URL=your_public_levels_manifest_url

# Leave empty when Huzzle and the DRYGON server share an origin.
VITE_DRYGON_API_URL=

# Development-only Vite proxy destination.
DRYGON_API_PROXY_TARGET=http://localhost:3000

# Enables the in-game testing panel in production-mode builds such as Android.
VITE_DEBUG_TOOLS=false

# Android AdMob. Test ads are used unless VITE_ADS_TESTING is explicitly false.
VITE_ADS_ENABLED=true
VITE_ADS_TESTING=true
ADMOB_ANDROID_APP_ID=
VITE_ADMOB_ANDROID_BANNER_ID=
VITE_ADMOB_ANDROID_INTERSTITIAL_ID=
VITE_ADMOB_ANDROID_REWARDED_ID=
VITE_AD_INTERSTITIAL_EVERY_LEVELS=2
